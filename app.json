{
  "expo": {
    "name": "travelbuddy-mobile",
    "slug": "travelbuddy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.travelbuddy.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.travelbuddy.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#6D8A43",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TravelBuddy uses your location to suggest nearby riders and share your live location when you turn sharing on.",
          "locationAlwaysAndWhenInUsePermission": "TravelBuddy shares your live location with accepted friends who also share theirs while live sharing is on, including when the app is in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TravelBuddy lets you choose a profile picture or ride banner from your photo library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "./plugins/with-work-database-proguard"
    ]
  }
}
